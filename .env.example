# UGC Donation Platform - Environment Variables
# Copy this file to .env and fill in the values before launching.

# Deployed Smart Contracts
VITE_UGC_TOKEN_ADDRESS=0xB7F8A53DFB91A8B5FE2f2c5d0CD0faD5C15C4304
VITE_DONATION_CONTRACT_ADDRESS=0xdae4E926B2f6526eE33E3857E706A706aab115d0

# Biconomy Gasless Configuration
# Get these from your Biconomy Dashboard (https://dashboard.biconomy.io)
VITE_BICONOMY_API_KEY=your_key_here
VITE_BICONOMY_BUNDLER_URL=https://bundler.biconomy.io/api/v2/11155111/your_key_here
VITE_BICONOMY_PAYMASTER_URL=https://paymaster.biconomy.io/api/v1/11155111/your_key_here
VITE_TRUSTED_FORWARDER=0xE4C33113074c4801111a0965d1d6a6669bc0915a # Sepolia default forwarder

# UGC Token Faucet / Swap Url (shown on zero balance banner)
VITE_UGC_FAUCET_URL=https://faucet.ugc.network
