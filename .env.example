# ══════════════════════════════════════════════
# CryptoAid — Environment Configuration
# ══════════════════════════════════════════════
# Copy this file to .env and fill in the values.

# ── Deployer Private Key (for contract deployment + gas funding) ──
PRIVATE_KEY=0xyour_deployer_private_key_here

# ── RPC URLs ──
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://rpc2.sepolia.org

# ── Deployed Smart Contracts (Base Sepolia) ──
# Run `node scripts/deploy.js` to get these values.
VITE_UGC_TOKEN_ADDRESS=0xYourMockUSDAddressHere
VITE_DONATION_CONTRACT_ADDRESS=0xYourDonationVaultAddressHere

# ── Target Chain (Base Sepolia = 84532) ──
VITE_TARGET_CHAIN_ID=84532

# ── UGF Gasless Configuration ──
# Get your API key from https://dashboard.ugf.network
VITE_UGF_API_KEY=ugf_test_your_key_here
VITE_UGF_ENDPOINT=https://testnet.api.ugf.network

# ── Mock USD Faucet URL (shown on zero-balance banner) ──
VITE_UGC_FAUCET_URL=https://faucet.ugf.network

# ── Backend + Realtime (Express + WebSocket) ──
VITE_BACKEND_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
